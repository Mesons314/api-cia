#!/bin/bash

# Git pre-push hook for API Change Impact Analysis
read local_ref local_sha remote_ref remote_sha

if [ -z "$local_sha" ] || [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    local_sha=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
else
    local_sha=$(git rev-parse --short "$local_sha" 2>/dev/null || echo "unknown")
fi

# Dynamically resolve repository root
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# 1. Convert POSIX/MSYS (/c/...) paths to Windows (C:/...) format on Windows
if command -v cygpath >/dev/null 2>&1; then
    REPO_ROOT=$(cygpath -m "$REPO_ROOT")
elif [[ "$REPO_ROOT" =~ ^/([a-zA-Z])/(.*) ]]; then
    REPO_ROOT="${BASH_REMATCH[1]^^}:/${BASH_REMATCH[2]}"
fi
REPO_ROOT=${REPO_ROOT//\\/\/}

# 2. Check source root path (detect src/main/java, fallback to src, or repo root)
if [ -d "${REPO_ROOT}/src/main/java" ]; then
    SOURCE_ROOT="${REPO_ROOT}/src/main/java"
elif [ -d "${REPO_ROOT}/src" ]; then
    SOURCE_ROOT="${REPO_ROOT}/src"
else
    SOURCE_ROOT="${REPO_ROOT}"
fi
SOURCE_ROOT=$(echo "$SOURCE_ROOT" | tr -d '\r\n')

# 3. Call API-CIA backend extraction preview endpoint
RESPONSE=$(curl -s -f --connect-timeout 4 -G "http://localhost:8080/api/extraction/openapi.json" \
    --data-urlencode "preview=true" \
    --data-urlencode "versionLabel=commit-${local_sha}" \
    --data-urlencode "sourceRoot=${SOURCE_ROOT}" 2>&1)
CURL_STATUS=$?

if [ $CURL_STATUS -ne 0 ] || [ -z "$RESPONSE" ]; then
    echo "ERROR: API Analyzer backend is unavailable at http://localhost:8080."
    echo "Push blocked because API impact analysis could not be completed."
    exit 1
fi

# 4. Parse response and format analysis report
PYTHON_CMD="python"
if command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD="python3"
fi

REPORT=$(echo "$RESPONSE" | $PYTHON_CMD -c '
import sys, json

try:
    data = json.load(sys.stdin)
except Exception as e:
    print("ERROR: Unable to parse API contract response: " + str(e))
    sys.exit(1)

if not isinstance(data, dict) or "error" in data or ("status" in data and isinstance(data["status"], int) and data["status"] >= 400):
    errMsg = data.get("message") or data.get("error") or "Unknown error" if isinstance(data, dict) else str(data)
    print("ERROR from backend: " + str(errMsg))
    sys.exit(1)

old_spec_id = data.get("oldSpecId") or "N/A"
old_version = data.get("oldVersion") or "N/A"
new_version = data.get("newVersion") or "commit-"

print("==================================================")
print("           API CHANGE IMPACT ANALYSIS             ")
print("==================================================")
print("Base Contract ID:    " + str(old_spec_id))
print("Base Version Label:  " + str(old_version))
print("Current Version:     " + str(new_version))
print("--------------------------------------------------")

sgm = data.get("sgm") or {}
violations = sgm.get("violations") or []
if not violations:
    print("No API changes detected.")
else:
    print("Detected Changes (" + str(len(violations)) + " total):")
    for v in violations:
        severity = v.get("severity") or "INFO"
        msg = v.get("message") or ""
        print("  [" + str(severity) + "] " + str(msg))
        if v.get("oldValue") and v.get("newValue") and v.get("changeType") == "ENDPOINT_RENAMED":
            print("      " + str(v.get("oldValue")) + " -> " + str(v.get("newValue")))

impact = data.get("impactScore") or {}
sTotal = impact.get("sTotal") or 0.0
riskLevel = impact.get("riskLevel") or "LOW"

print("--------------------------------------------------")
print("Risk Score: " + str(int(float(sTotal) * 100)) + "/100 | Risk Level: " + str(riskLevel))
print("==================================================")
' 2>&1)

PYTHON_STATUS=$?
if [ $PYTHON_STATUS -ne 0 ] || [[ "$REPORT" == *"ERROR"* ]]; then
    echo "$REPORT"
    echo "Push blocked."
    exit 1
fi

echo "$REPORT"

# 5. Interactive prompt to confirm push
echo -n "Do you want to continue with this push? (y/N): "
read yn < /dev/tty

if [[ "$yn" =~ ^[yY](es)?$ ]]; then
    echo "Push approved. Proceeding..."
    exit 0
else
    echo "ERROR: Push aborted by user."
    exit 1
fi
